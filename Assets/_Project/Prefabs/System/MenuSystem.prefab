      m_Calls: []
  m_text: "<size=32><b>DEVELOPMENT TEAM</b></size>\r\n\r\n<size=24><b>Aurora Cousins</b></size>\r\n<size=18><i>Programmer,
    Level Designer, 3D Modeler, & Q/A</i></size>\r\n\r\n<size=24><b>Mike Williams</b></size>\r\n<size=18><i>UI
    Programming & Design \u2022 Lighting & Atmosphere \u2022 Music & Audio \u2022
    Gameplay Integration</i></size>\r\n\r\n<size=24><b>Taylor Porath</b></size>\r\n<size=18><i>Gameplay
    Programmer \u2022 Level Designer \u2022 Narrative Designer (Desert) \u2022 Voice
    (Entity for Desert)  </i></size>\r\n\r\n<size=24><b>Jamie Saker</b></size>\r\n<size=18><i>Enemy
    Programmer, VFX and ShaderGraphs</i></size>\r\n\r\n<size=24><b>Gretchen Baune</b></size>\r\n<size=18><i>Programmer,
    Level design</i></size>\r\n\r\n\r\n<size=32><b>ADDITIONAL CREDITS</b></size>\r\n\r\n<size=24><b>3D
    Assets</b></size>\r\n<size=18><i>studio.tripo3D.ai</i></size>\r\n<size=18><i>Unity
    Asset Store<i></size>\r\n\r\n<size=24><b>Audio</b></size>\r\n<size=18><i>freesound.org<i></size>\n<size=18><i>audacity.com<i></size>\n<size=18><i>pixabay.com<i></size>\n\r\n<size=18><b>Main
    Menu Music</b>\r\n<i>Original Riff & Creative Direction</i>: Mike Williams\r\n<i>AI-Assisted
    Music Production</i>: Suno</size>\r\n\r\n<size=18><b>Gameplay Music</b>\r\n<i>Emotional
    Themes Pack 1</i>\r\nCreated by Christopher Baklid\r\n<i>Unity Asset Store</i></size>\r\n\r\n<size=18><b>Menu
    Sound Effects</b>\r\n<i>Fantasy Menu SFX</i>\r\nCreated by Chris M Audio\r\n<i>Unity
    Asset Store</i></size>\r\n\r\n\r\n<size=24><b>Unity Assets</b></size>\r\n\r\n<size=18><b>Menus,
    HUD & Spell Icons</b>\r\n<i>GUI Parts</i>\r\nCreated by PONETI\r\n<i>Unity Asset
    Store</i></size>\r\n\r\n<size=18><b>Crosshair</b>\r\n<i>Crosshairs</i>\r\nCreated
    by OccaSoftware\r\n<i>Unity Asset Store</i></size>\r\n\r\n\r\n<size=32><b>SPECIAL
    THANKS</b></size>\r\n\r\n<size=18><i>Full Sail University</i></size>"
